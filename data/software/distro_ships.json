    "debian_versions": "https://sources.debian.org/api/src/bind9/, /pdns/, /knot/ (versions per suite, read 2026-09-15)",
    "debian_dates": "https://www.debian.org/releases/",
    "rhel_dates": "https://en.wikipedia.org/wiki/Red_Hat_Enterprise_Linux (GA dates, read 2026-09-16)",
    "rhel_versions": "directory listings read 2026-09-16: https://vault.centos.org/7.9.2009/os/x86_64/Packages/ , https://dl.rockylinux.org/vault/rocky/8.5/AppStream/x86_64/os/Packages/ , https://dl.rockylinux.org/pub/rocky/9/AppStream/x86_64/os/Packages/ , https://dl.fedoraproject.org/pub/epel/9/Everything/x86_64/Packages/"
